{
  "name": "real-estate-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "start": "vite preview",
    "lint": "eslint .",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vitest run",
    "deploy": "cf deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply <DATABASE_ID> --local --dir migrations",
    "db:migrate:remote": "cf d1 migrations apply <DATABASE_ID> --dir migrations"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.21",
    "@hookform/resolvers": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "latest",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.91.0",
    "react-server-dom-webpack": "latest",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.3.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.5",
    "@eslint/js": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "cf": "1.0.0-beta.23",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "miniflare": "5.20261023.0-beta",
    "tailwindcss": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vite": "8.3.0",
    "vitest": "latest"
  }
}
